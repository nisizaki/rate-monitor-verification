+import { experimentTrace, translationProbe } from "./experiment_telemetry.ts";
+import { DeepLHttpError } from "./errors.ts";
+
+Deno.test("all modes correlate events without copying inputs or arbitrary trial IDs", async () => {
+  for (const mode of ["baseline", "record", "monitor"] as const) {
+    const events: Record<string, unknown>[] = [];
+    const emit = experimentTrace(mode, "invalid", (e) => events.push(e));
+    const input = String.fromCodePoint(0x1f642, 0x3042);
+    const probe = translationProbe(
+      (text) => Promise.resolve(text),
+      emit,
+      () => 1,
+    );
+    if (await probe(input) !== input) throw new Error("changed result");
+    if (events[0].submitted_codepoints !== 2 || events[0].trial_id !== null) {
+      throw new Error("invalid metadata");
+    }
+    if (JSON.stringify(events).includes(input)) throw new Error("body leak");
+    if (events[0].api_billed_characters !== null) {
+      throw new Error("invented usage");
+    }
+  }
+});
+Deno.test("HTTP 429 preserved and emit failure cannot mask the error", async () => {
+  const error = new DeepLHttpError(429);
+  const events: Record<string, unknown>[] = [];
+  const input = String.fromCodePoint(0x3042);
+  for (
+    const emit of [(e: Record<string, unknown>) => events.push(e), () => {
+      throw new Error("sink");
+    }]
+  ) {
+    try {
+      await translationProbe(() => Promise.reject(error), emit)(input);
+      throw new Error("expected error");
+    } catch (actual) {
+      if (actual !== error) throw new Error("masked error");
+    }
+  }
+  if (events[0].http_status !== 429) {
+    throw new Error("missing rate-limit status");
+  }
+});
+Deno.test("sequence detects local sink drop", () => {
+  const events: Record<string, unknown>[] = [];
+  let first = true;
+  const emit = experimentTrace("baseline", undefined, (e) => {
+    if (first) {
+      first = false;
+      throw new Error("sink");
+    }
+    events.push(e);
+  });
+  emit({ kind: "experiment_start" });
+  emit({ kind: "experiment_result" });
+  if (events[0].seq !== 1 || events[0].emit_failures !== 1) {
+    throw new Error("missing drop");
+  }
+});
