+import { DeepLHttpError, DeepLTimeoutError } from "./errors.ts";
+
+// Synchronous observation faults become missing values, never business failures.
+export function observationValue<T>(read: () => T): T | null {
+  try {
+    return read();
+  } catch {
+    return null;
+  }
+}
+export function observationTime(
+  clock: () => number = () => performance.now(),
+): number | null {
+  const value = observationValue(clock);
+  return typeof value === "number" && Number.isFinite(value) && value >= 0
+    ? value
+    : null;
+}
+export function observationElapsed(
+  start: number | null,
+  end: number | null,
+): number | null {
+  return start !== null && end !== null && end >= start ? end - start : null;
+}
+
+export function translationProbe(
+  translate: (text: string) => Promise<string>,
+  emit: (event: Record<string, unknown>) => void,
+  clock: () => number = () => performance.now(),
+) {
+  return async (text: string): Promise<string> => {
+    const start = observationTime(clock);
+    const chars = observationValue(() => Array.from(text).length);
+    let outcome = "success";
+    let httpStatus: number | null = null;
+    try {
+      return await translate(text);
+    } catch (error) {
+      outcome = "failure";
+      try {
+        outcome = error instanceof DeepLTimeoutError ? "timeout" : "failure";
+        if (error instanceof DeepLHttpError) httpStatus = error.status;
+      } catch {
+        // Classification must not replace even an exotic original rejection.
+        httpStatus = null;
+      }
+      throw error;
+    } finally {
+      try {
+        emit({
+          kind: "translation_result",
+          translation_ms: observationElapsed(start, observationTime(clock)),
+          submitted_codepoints: chars,
+          outcome,
+          http_status: httpStatus,
+          api_billed_characters: null,
+          usage_provenance: "unavailable",
+        });
+      } catch {
+        // Observation cannot change translation outcomes.
+      }
+    }
+  };
+}
+
+export function experimentTrace(
+  mode: "baseline" | "record" | "monitor",
+  trialId: string | undefined,
+  emit: (event: Record<string, unknown>) => void,
+  invocationId?: string,
+) {
+  const uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/;
+  const runId = observationValue(() => {
+    const value = invocationId ?? crypto.randomUUID();
+    return uuid.test(value) ? value : null;
+  });
+  let seq = 0;
+  let dropped = 0;
+  return (event: Record<string, unknown>) => {
+    try {
+      emit({
+        ...event,
+        schema_version: 2,
+        run_id: runId,
+        trial_id: trialId && uuid.test(trialId) ? trialId : null,
+        mode,
+        seq: seq++,
+        emit_failures: dropped,
+      });
+    } catch {
+      dropped++;
+    }
+  };
+}
